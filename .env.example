# Django
DJANGO_SECRET_KEY=replace-this-with-a-long-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO

# Local paths (relative paths are resolved from the project root)
DATA_ROOT=data
QDRANT_PATH=storage/qdrant
THEATRE_DATASET_PATH=Bangla_Natok_500_MultiView_RAG_Dataset/bangla_natok_500

# Embeddings
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16
QDRANT_UPSERT_BATCH_SIZE=64
RAG_CONTEXT_MAX_CHARS=24000

# Local Ollama server
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=120
